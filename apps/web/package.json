{
  "name": "@test-platform/web",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "description": "Testd web UI: author, run and inspect functional tests.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "typecheck": "vue-tsc --build",
    "lint:check": "eslint .",
    "format:check": "prettier --check src e2e playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "~10.5.1",
    "jiti": "^2.6.1",
    "jsdom": "^30.1.2",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/vue-query": "^5.104.1",
    "@test-platform/contracts": "workspace:*",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.1.0",
    "ace-builds": "^1.45.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  }
}
