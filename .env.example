TEST_PLATFORM_RUNTIME_DIR=./runtime
TEST_PLATFORM_DEFINITIONS_DIR=./definitions
TEST_PLATFORM_CONFIG_DIR=./config
TEST_PLATFORM_API_PORT=3000
TEST_PLATFORM_WORKER_HEALTH_PORT=3001
# Mock API helper: the worker serves it; the API shows the address the system under test calls.
# Bind the host to 0.0.0.0 only if the system under test runs elsewhere (there is no authentication),
# and set MOCK_API_PUBLIC_URL to the address it should use (for example http://my-pc.local:3002).
TEST_PLATFORM_MOCK_API_PORT=3002
# TEST_PLATFORM_MOCK_API_HOST=127.0.0.1
# TEST_PLATFORM_MOCK_API_PUBLIC_URL=http://127.0.0.1:3002
TEST_PLATFORM_LOG_LEVEL=info
# --- API (all optional; defaults shown) ---
# TEST_PLATFORM_API_HOST=127.0.0.1
# TEST_PLATFORM_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TEST_PLATFORM_API_BODY_LIMIT_BYTES=1048576
# TEST_PLATFORM_API_SSE_POLL_MS=500
# TEST_PLATFORM_API_SSE_HEARTBEAT_MS=15000
# TEST_PLATFORM_MAX_ARTIFACT_BYTES=52428800
# TEST_PLATFORM_ENVIRONMENTS_FILE=environments.local.json
# TEST_PLATFORM_AUTH_MODE=local-dev
# TEST_PLATFORM_DEV_USER=local-dev-user
# --- Secrets (names only here; put real values in your own untracked .env or secrets file) ---
# localPlainText references resolve from TEST_PLATFORM_SECRET_<NAME> first (dashes become
# underscores, upper-case: "orders-service-bus-connection" -> ORDERS_SERVICE_BUS_CONNECTION),
# then from runtime/secrets.local.json (Git-ignored; owner-only permissions on POSIX hosts).
# TEST_PLATFORM_SECRET_ORDERS_SERVICE_BUS_CONNECTION=
# TEST_PLATFORM_SECRET_ORDERS_API_KEY=
# keyVault references: vault for bare secret names, and sign in with `az login` or a workload identity.
# TEST_PLATFORM_KEY_VAULT_URL=https://<your-vault>.vault.azure.net
# --- Worker (all optional; defaults shown) ---
# TEST_PLATFORM_WORKER_ID=
# TEST_PLATFORM_WORKER_POLL_MS=1000
# TEST_PLATFORM_WORKER_LEASE_MS=30000
# TEST_PLATFORM_WORKER_LEASE_RENEW_MS=10000
# TEST_PLATFORM_WORKER_REAPER_MS=10000
# TEST_PLATFORM_WORKER_CANCEL_POLL_MS=500
# TEST_PLATFORM_WORKER_SHUTDOWN_GRACE_MS=10000
# TEST_PLATFORM_WORKER_DEFAULT_STEP_TIMEOUT_SECONDS=300
# TEST_PLATFORM_WORKER_PAYLOAD_CAPTURE_BYTES=65536
# --- Service Bus Inspector (worker; the API needs the same MAX_MESSAGES) ---
# TEST_PLATFORM_INSPECTOR_POLL_MS=5000
# TEST_PLATFORM_INSPECTOR_MAX_MESSAGES=10000
# --- Docker Compose only ---
# Host port for the web app (published on 127.0.0.1 only).
# TEST_PLATFORM_WEB_PORT=8080
# --- Opt-in Azure sandbox tests (see ../Docs/Phase 2/azure-sandbox-validation.md); leave unset normally ---
# TEST_PLATFORM_AZURE_SANDBOX=1
