{
  "environments": [
    {
      "id": "orders-test",
      "name": "Orders test environment",
      "classification": "TEST",
      "limits": {
        "maxSuiteConcurrency": 2
      },
      "targets": {
        "orders-storage": {
          "kind": "azureBlob",
          "accountUrl": "https://example.blob.core.windows.net",
          "allowedContainers": ["inbound-orders"],
          "allowedOperations": ["upload", "download"],
          "allowedBlobPrefixes": ["orders/"]
        },
        "orders-events": {
          "kind": "azureServiceBus",
          "fullyQualifiedNamespace": "example.servicebus.windows.net",
          "allowedEntities": ["order-events"],
          "allowedOperations": ["send"],
          "credential": {
            "type": "secretReference",
            "usage": "connectionString",
            "provider": "localPlainText",
            "name": "orders-service-bus-connection"
          }
        },
        "orders-api": {
          "kind": "http",
          "baseUrl": "https://example.azure-api.net",
          "allowedPaths": ["/orders/*"],
          "authentication": {
            "type": "secretReference",
            "provider": "keyVault",
            "name": "orders-api-key"
          }
        },
        "orders-api-by-uri": {
          "kind": "http",
          "baseUrl": "https://example.azure-api.net",
          "allowedPaths": ["/orders/*"],
          "authentication": {
            "type": "secretReference",
            "provider": "keyVault",
            "name": "https://orders-kv.vault.azure.net/secrets/orders-api-key"
          }
        }
      }
    }
  ]
}
