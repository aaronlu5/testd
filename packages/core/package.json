{
  "name": "@test-platform/core",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Framework-independent domain rules and ports. No storage, HTTP, or Azure implementations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "tsc -b --clean",
    "test": "tsc -b && vitest run"
  },
  "dependencies": {
    "@test-platform/contracts": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
